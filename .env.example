# Copy this file to .env for local runs. On Render, set these as Environment Variables instead.

# ---------------------------------------------------------------------------
# Supabase — Project Settings -> API in your Supabase dashboard
# ---------------------------------------------------------------------------
# Your project's URL, e.g. https://abcdefghijklmno.supabase.co
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The "anon" / "public" key. Safe to expose to the browser — this app serves it
# to the frontend via GET /api/auth/config so supabase-js can run there. It can
# only do what the RLS policies in supabase/schema.sql allow.
SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-PUBLIC-KEY

# The "service_role" key. SERVER-SIDE ONLY — never send this to the browser,
# never commit it, never log it. It bypasses Row Level Security entirely, which
# is why the server (not the browser) uses it to manage encrypted MEGA
# credentials and file records on each user's behalf.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SUPABASE-SERVICE-ROLE-SECRET-KEY

# Before running the app: open supabase/schema.sql, run it in your Supabase
# project's SQL Editor, and enable "Confirm email" under
# Authentication -> Providers -> Email in the Supabase dashboard (required for
# the sign-up email verification flow to actually send/enforce anything).

# ---------------------------------------------------------------------------
# App secrets
# ---------------------------------------------------------------------------
# Random string, used to AES-256-GCM encrypt each connected MEGA account's
# password at rest (on top of Supabase's own storage security).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=replace-with-a-64-char-hex-string

# Port the server listens on (Render sets this automatically, safe to leave as-is).
PORT=3000

# Max size (bytes) of a single object stored on ONE mega account before MegaPool
# automatically splits it across multiple accounts. Default 4GB.
CHUNK_MAX_BYTES=4294967296
