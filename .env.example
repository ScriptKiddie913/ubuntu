# Google Cloud OAuth client (see README for how to get these)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx

# Must exactly match the URI you added in Google Cloud Console
# local:  http://localhost:8000/oauth/callback
# render: https://<your-app>.onrender.com/oauth/callback
REDIRECT_URI=http://localhost:8000/oauth/callback

# Fernet key used to encrypt refresh tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# Optional. If unset, falls back to local SQLite at /var/data/multidrive.db
# (ephemeral on Render unless you attach a persistent disk there — use
# Render's free Postgres addon instead for real deployments).
DATABASE_URL=

CHUNK_SIZE_BYTES=3221225472
SAFETY_MARGIN_BYTES=209715200
