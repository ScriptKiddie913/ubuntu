# Copy this file to .env for local runs. On Render, set these as Environment Variables instead.

# Password to log into the MegaPool web dashboard itself (required).
ADMIN_PASSWORD=change-me-please

# Random long random string, used to encrypt your stored MEGA account passwords at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=replace-with-a-64-char-hex-string

# Used to sign the login session cookie. Any long random string.
SESSION_SECRET=replace-with-another-random-string

# Port the server listens on (Render sets this automatically, safe to leave as-is).
PORT=3000

# Max size (bytes) of a single object stored on ONE mega account before MegaPool
# automatically splits it across multiple accounts. Default 4GB.
CHUNK_MAX_BYTES=4294967296
